# Derle, sonra nginx ile sun. /api istekleri arka uca iletilir (aynı köken: çerez/CORS sorunu yok).
FROM node:22-alpine AS derle
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=derle /app/dist /usr/share/nginx/html

# Geliştirme ortamı için örnek. Kopyala: cp .env.example .env
# Üretimde bu değerler sunucuda üretilir, depoya girmez.

ENV=dev

# Docker Compose içinden bağlantı (servis adları)
DATABASE_URL=postgresql+asyncpg://rota:rota_dev_sifre@db:5432/rota
REDIS_URL=redis://redis:6379/0

# Testler ayrı veritabanı ve ayrı Redis dizini kullanır
TEST_DATABASE_URL=postgresql+asyncpg://rota:rota_dev_sifre@db:5432/rota_test
TEST_REDIS_URL=redis://redis:6379/1

# openssl rand -hex 32 ile üret
JWT_SECRET=degistir-beni

# T.C. kimlik numarası şifreleme ve tekrar kontrolü. İkisi de farklı olmalı.
# Üret: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# DİKKAT: şifreleme anahtarı kaybolursa kayıtlı kimlik numaraları geri okunamaz, yedeğini alın.
KIMLIK_SIFRELEME_ANAHTARI=degistir-beni
KIMLIK_OZET_ANAHTARI=degistir-beni

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Boşta kalma süresi (dakika): hareket olmazsa oturum bu sürede kapanır. Önyüzdeki sayaçla aynı olmalı (30).
BOSTA_DAKIKA=30
# Beni hatırla: yalnız çerezin kalıcı olduğu gün sayısı (oturum yine boşta süresiyle kapanır)
HATIRLA_CEREZ_GUN=30

# Geliştirmede http kullanıldığı için false. Üretimde true olmalı.
COOKIE_SECURE=false

# Virgülle ayrılmış izinli kökenler
CORS_ORIGINS=http://localhost:5174

# Yüklenen fotoğrafların saklandığı dizin (herkese açık sunulmaz)
DOSYA_DIZINI=/app/uploads

# Web Push (VAPID). Boşsa push gönderimi kapalıdır (bildirimler beklemede kalır).
# Anahtar çifti üret: docker compose run --rm backend python -m app.cli vapid-uret
# Özel anahtarı gizli tutun; genel anahtar tarayıcıya verilir. Anahtar değişirse eski abonelikler geçersiz olur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kulup@example.com

# WhatsApp (Evolution API). URL ve anahtar doluysa yönetici Ayarlar'dan QR ile numara bağlayabilir.
# Anahtar, Evolution servisindeki AUTHENTICATION_API_KEY ile aynı olmalı (üretimde: openssl rand -hex 32).
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=rota-dev-evolution-anahtari
EVOLUTION_INSTANCE=rota
